# LLM (provider-neutral: gemini | anthropic | openai | mock)
LLM_PROVIDER=gemini
LLM_API_KEY=
# Comma-separated = fallback order (free tiers rate-limit per model)
LLM_MODEL_FAST=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview
LLM_MODEL_STRONG=gemini-flash-latest,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# Embeddings (gemini | openai | voyage | local)
EMBED_PROVIDER=gemini
EMBED_API_KEY=
EMBED_MODEL=gemini-embedding-001

# Fixed "today" so the demo and evals are reproducible
APP_TODAY=2026-10-04

# Max time for one model call across all retries and fallback models (then "review manually")
LLM_CALL_BUDGET_MS=300000
