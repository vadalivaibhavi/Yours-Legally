# ============================================================================
# Two profiles. The FINAL build (deployed on Vercel) is Gemini for both the
# model and the embeddings. LOCAL testing and evals can use Ollama instead.
# Local runs write their own briefs (data/briefs-ollama) and clause index
# (data/clause_index.ollama.json): they never touch the final, committed ones.
# Vercel can't reach a local Ollama, so the deployed app must use Gemini.
# ============================================================================

# --- Model -------------------------------------------------------------------
# FINAL: gemini.  LOCAL: ollama.  (anthropic | openai | mock also exist)
LLM_PROVIDER=gemini
LLM_API_KEY=
# Comma-separated = fallback order (free tiers rate-limit per model)
LLM_MODEL_FAST=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview
LLM_MODEL_STRONG=gemini-flash-latest,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# --- Embeddings ----------------------------------------------------------------
# FINAL: gemini (the committed clause index is built with gemini-embedding-001).
# LOCAL: ollama + `npm run build:index` once (builds data/clause_index.ollama.json).
EMBED_PROVIDER=gemini
EMBED_API_KEY=
EMBED_MODEL=gemini-embedding-001

# --- Local testing with Ollama (uncomment to switch; no key, no quota, no cost) ---
# LLM_PROVIDER=ollama
# EMBED_PROVIDER=ollama
# OLLAMA_MODEL_FAST=llama3.2
# OLLAMA_MODEL_STRONG=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=32768

# Fixed "today" so the demo and evals are reproducible
APP_TODAY=2026-10-04

# Max time for one model call across all retries and fallback models (then "review manually").
# Waiting out a per-minute 429 doesn't count against it. Ollama ignores this (OLLAMA_CALL_BUDGET_MS, default 20 min).
LLM_CALL_BUDGET_MS=300000

# Free-tier pacing (Gemini): minimum gap between model calls, and deals reviewed at once by npm run review.
# Ollama ignores these: a local model has no rate limit.
LLM_MIN_INTERVAL_MS=4000
REVIEW_CONCURRENCY=1
