{
  "name": "yours-legally",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest.ts",
    "build:register": "tsx scripts/buildRegister.ts",
    "check:register": "tsx scripts/checkRegister.ts",
    "build:index": "tsx scripts/buildClauseIndex.ts",
    "search": "tsx scripts/search.ts",
    "build:eval": "tsx scripts/buildEvalCases.ts",
    "review": "tsx scripts/review.ts",
    "eval": "tsx scripts/eval.ts",
    "data": "npm run ingest && npm run build:register && npm run build:index && npm run build:eval",
    "cost": "tsx scripts/cost.ts",
    "demo:reset": "tsx scripts/resetDemo.ts",
    "pending": "tsx scripts/pending.ts",
    "check:upload-detect": "tsx scripts/checkUploadDetect.ts",
    "consistency": "tsx scripts/consistency.ts",
    "fixtures:formats": "tsx scripts/makeFormatFixtures.ts && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/makeFormatFixtures.ps1",
    "check:file-read": "tsx scripts/checkFileRead.ts"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
