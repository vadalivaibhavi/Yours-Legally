
# runtime cache + local state (rebuilt on demand)
# secrets: never commit
*.tsbuildinfo
.DS_Store
.env
.env.*.local
.env.local
.next/
.vercel
__MACOSX/
data/*.log
# The model cache is committed (answers and embeddings for the synthetic dataset, no keys), so a fresh clone and CI
# can run npm run check without an API key. The quota records stay local.
data/cache/quota-exhausted-*
data/dev.log
data/state/
next-env.d.ts
node_modules/
out/
data/briefs/failed/
data/state-backups/
# local testing (Ollama) outputs: never committed, never shipped
data/briefs-*/
# masked reviews (FR-26 demo, Gemini) are committed: the app shows them with MASKING=on
!data/briefs-masked/
data/clause_index.*.json
